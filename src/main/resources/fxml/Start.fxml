<AnchorPane prefHeight="400.0" prefWidth="500.0" stylesheets="@../css/start.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="entry.Start">
   <children>
      <Button fx:id="CLIButton" focusTraversable="false" layoutX="145.0" layoutY="183.0" mnemonicParsing="false" prefHeight="71.0" prefWidth="210.0" text="Command Line Interface" textAlignment="CENTER" wrapText="true">
         <font>
            <Font name="JetBrains Mono Regular" size="12.0" />
         </font></Button>
      <Button fx:id="GUIButton" focusTraversable="false" layoutX="145.0" layoutY="287.0" mnemonicParsing="false" prefHeight="71.0" prefWidth="210.0" text="Graphical User Interface" textAlignment="CENTER" wrapText="true" />
      <ImageView fitWidth="400.0" layoutX="50.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/Logo.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
