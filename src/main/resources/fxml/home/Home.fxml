<?import javafx.scene.layout.*?>
<fx:root hbarPolicy="NEVER" prefHeight="1000.0" prefWidth="830.0" stylesheets="@../../css/home/Home.css" type="ScrollPane" vbarPolicy="NEVER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
