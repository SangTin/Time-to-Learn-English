                     </children>
                     <padding>
                        <Insets left="40.0" right="40.0" top="25.0" />
                     </padding>
                  </VBox>
               </center>
               <right>
                  <VBox prefWidth="199.0" spacing="10.0" BorderPane.alignment="CENTER">
