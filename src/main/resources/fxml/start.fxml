      <Label contentDisplay="CENTER" layoutX="130.0" layoutY="37.0" prefHeight="62.0" prefWidth="240.0" styleClass="root" text="Which version do you want to use ?" textAlignment="CENTER" wrapText="true">
         <font>
            <Font name="JetBrains Mono Regular" size="20.0" />
         </font>
      </Label>
      <Button fx:id="CLIButton" layoutX="155.0" layoutY="128.0" mnemonicParsing="false" prefHeight="76.0" prefWidth="190.0" stylesheets="@../css/start.css" text="Command Line Interface" textAlignment="CENTER" wrapText="true">
         <font>
            <Font name="JetBrains Mono Regular" size="12.0" />
         </font></Button>
      <Button fx:id="GUIButton" layoutX="155.0" layoutY="230.0" mnemonicParsing="false" prefHeight="76.0" prefWidth="190.0" stylesheets="@../css/start.css" text="Graphical User Interface" textAlignment="CENTER" wrapText="true" />
   </children>
</AnchorPane>
